flowchart LR

    subgraph core["Core Pipeline"]
    direction RL
        jobmanager@{ shape: rect, label: "Job Manager" }
        downloader@{ shape: rounded, label: "Downloader"}
        logging@{ shape: rounded, label: "Logging"}
        cookiemanager@{ shape: rounded, label: "Cookie Manager"}

        subgraph bus["DataBus"]
            direction TB
            inqueue@{ shape: cyl, label:"Incoming Queue"}
            outqueue@{ shape: cyl, label:"Outgoing Queue"}
        end

        downloader -- "Update & Push Jobs" --> inqueue
        inqueue -- "Consume Jobs" --> jobmanager
        jobmanager -- "Schedule & Push Jobs" --> outqueue
        jobmanager --> logging
        cookiemanager --> downloader
        outqueue -- "Consume Jobs" --> downloader
    style jobmanager fill:#D6EAF8,stroke:#2471A3,color:#154360,stroke-width:2px
    style downloader fill:#FCF3CF,stroke:#D4AC0D,color:#7D6608,stroke-width:2px
    style inqueue fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px
    style outqueue fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px
    style bus fill:#F4F6F7,stroke:#7B7D7D,color:#2C3E50,stroke-width:2px

    end


    subgraph job["Job Creation"]
    direction TD
        inputfile@{shape: manual-input, label: "Input File"}
        
        logs@{ shape: docs, label: "Logs" }
        jobhistory@{ shape: rounded, label: "Job History" }
        jobbuilder@{ shape: rounded, label: "Job Builder" }
        subgraph listen["Clipboard Monitoring"]
        direction TD
            lisqueue@{ shape: cyl, label: "Listening Queue" }
            listener@{ shape: rounded, label: "Listener"}
            worker@{ shape: rounded, label: "Listener Worker"}

            
        end
    logs --> jobhistory
    jobhistory --> jobbuilder
    inputfile --> jobbuilder
    listener --> lisqueue
    lisqueue --> worker
    worker --> jobbuilder
    worker --> inputfile
    jobbuilder -->inqueue

    style jobhistory fill:#D7BDE2,stroke:#884EA0,color:#1B2631
        style jobbuilder fill:#D6EAF8,stroke:#2471A3,color:#154360,stroke-width:2px

end

style listen fill:#F5F9FF,stroke:#C6DAF7,stroke-width:1.5px
style job fill:#FFF6F8,stroke:#F2CAD5,stroke-width:1.5px



style listener fill:#D6EAF8,stroke:#2471A3,color:#154360,stroke-width:2px
    
    
    style worker fill:#FADBD8,stroke:#C0392B,color:#78281F,stroke-width:2px
