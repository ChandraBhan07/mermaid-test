flowchart LR

    subgraph core["Core Pipeline"]
    direction RL
        jobmanager@{ shape: rect, label: "Job Manager" }
        downloader@{ shape: rounded, label: "Downloader" }
        logging@{ shape: rounded, label: "Logging" }
        cookiemanager@{ shape: rounded, label: "Cookie Manager" }

        subgraph bus["DataBus"]
            direction TB
            inqueue@{ shape: cyl, label: "Incoming Queue" }
            outqueue@{ shape: cyl, label: "Outgoing Queue" }
        end

        downloader -- "Update & Push Jobs" --> inqueue
        inqueue -- "Consume Jobs" --> jobmanager
        jobmanager -- "Schedule & Push Jobs" --> outqueue
        jobmanager --> logging
        cookiemanager --> downloader
        outqueue -- "Consume Jobs" --> downloader
    end

    subgraph job["Job Creation"]
    direction TD
        inputfile@{ shape: manual-input, label: "Input File" }
        logs@{ shape: docs, label: "Logs" }
        jobhistory@{ shape: rounded, label: "Job History" }
        jobbuilder@{ shape: rounded, label: "Job Builder" }

        subgraph listen["Clipboard Monitoring"]
        direction TD
            lisqueue@{ shape: cyl, label: "Listening Queue" }
            listener@{ shape: rounded, label: "Listener" }
            worker@{ shape: rounded, label: "Listener Worker" }
        end

        logs --> jobhistory
        jobhistory --> jobbuilder
        inputfile --> jobbuilder
        listener --> lisqueue
        lisqueue --> worker
        worker --> jobbuilder
        worker --> inputfile
        jobbuilder --> inqueue
    end

    %% Component colors
    classDef primary fill:#DCEBFF,stroke:#6D9EEB,color:#193B66,stroke-width:1.8px
    classDef process fill:#EAF2FC,stroke:#9BB8DE,color:#294765,stroke-width:1.5px
    classDef queue fill:#DDF5EA,stroke:#70B99A,color:#205C46,stroke-width:1.8px
    classDef monitor fill:#FCEBDD,stroke:#E5AC83,color:#79482D,stroke-width:1.8px
    classDef history fill:#EEE7FA,stroke:#B3A0D9,color:#4D3B70,stroke-width:1.5px
    classDef neutral fill:#F1F4F8,stroke:#B8C4D3,color:#39485A,stroke-width:1.5px

    %% Core Pipeline
    class jobmanager,jobbuilder primary
    class downloader,cookiemanager,logging process
    class inqueue,outqueue queue

    %% Job Creation
    class inputfile,logs neutral
    class jobhistory history

    %% Clipboard Monitoring
    class lisqueue queue
    class listener,worker monitor

    %% Subgraph backgrounds
    style core fill:#F4F8FF,stroke:#B8CCE8,stroke-width:1.5px,color:#294765
    style bus fill:#EDF8F2,stroke:#A8D6BE,stroke-width:1.5px,color:#285B48
    style job fill:#F8F5FF,stroke:#D0C3EB,stroke-width:1.5px,color:#51416F
    style listen fill:#FFF7F0,stroke:#F0D0B7,stroke-width:1.5px,color:#79482D

    %% Consistent connectors
    linkStyle default stroke:#91A4BB,stroke-width:1.5px,color:#52677E
